---
import experienceData from '../data/experience.json';

const expKeys = [
  { roleKey: 'exp1Role', companyKey: 'exp1Company', projectKey: 'exp1Project', periodKey: 'exp1Period', descKey: 'exp1Desc' },
  { roleKey: 'exp2Role', companyKey: 'exp2Company', projectKey: 'exp2Project', periodKey: 'exp2Period', descKey: 'exp2Desc' },
  { roleKey: 'exp3Role', companyKey: 'exp3Company', projectKey: '', periodKey: 'exp3Period', descKey: 'exp3Desc' },
];
---

<section id="experience" class="py-16 sm:py-24 border-b border-gray-100 dark:border-white/8 bg-[#FFFFFF] dark:bg-[#0B1120] transition-colors duration-300 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full">
    <div class="max-w-2xl mb-12">
      <div 
        data-i18n="expEyebrow"
        class="inline-block text-xs font-bold uppercase tracking-widest text-[#0047FF] dark:text-[#60A5FA] mb-2"
      >
        Pengalaman Kerja
      </div>
      <h2 
        data-i18n="expTitle"
        class="font-display text-3xl sm:text-4xl font-bold text-text-primary mb-4"
      >
        Pengalaman Lapangan &amp; Profesional
      </h2>
      <p 
        data-i18n="expSubtitle"
        class="text-base text-text-secondary"
      >
        Linimasa pengalaman profesional, latar belakang akademis, dan kontribusi komunitas saya.
      </p>
    </div>

    <!-- Vertical Timeline with Scroll Progress Line & Indicator Dot -->
    <div id="timeline-container" class="relative pl-6 sm:pl-8 border-l-2 border-gray-200 dark:border-white/8 max-w-3xl space-y-10">
      
      <!-- Active Timeline Progress Fill Line -->
      <div 
        id="timeline-progress-bar"
        class="absolute left-[-2px] top-0 w-0.5 bg-gradient-to-b from-[#0047FF] via-[#3B82F6] to-[#60A5FA] rounded-full transition-all duration-150 pointer-events-none"
        style="height: 0%;"
      ></div>

      <!-- Moving Timeline Progress Dot -->
      <div 
        id="timeline-progress-dot"
        class="absolute left-[-7px] top-0 w-3.5 h-3.5 rounded-full bg-[#0047FF] dark:bg-[#60A5FA] shadow-md border-2 border-white dark:border-[#0B1120] transition-all duration-150 pointer-events-none"
        style="transform: translateY(0px);"
      ></div>

      {experienceData.map((exp, idx) => {
        const keys = expKeys[idx] || { roleKey: '', companyKey: '', projectKey: '', periodKey: '', descKey: '' };
        return (
          <div 
            class="relative group experience-card-reveal"
          >
            <!-- Timeline Node Circle -->
            <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-white dark:bg-[#0B1120] border-2 border-[#0047FF] dark:border-[#60A5FA] group-hover:bg-[#0047FF] dark:group-hover:bg-[#60A5FA] transition-colors"></div>

            <!-- Timeline Content Card -->
            <div class="p-6 rounded-2xl glass-card interactive-card">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold text-[#0047FF] dark:text-[#60A5FA] bg-blue-50 dark:bg-blue-950/20 border border-blue-100 dark:border-blue-900/30">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                  <span data-i18n={keys.roleKey}>{exp.role}</span>
                </span>
                <span class="inline-flex items-center gap-1 text-xs font-medium text-text-muted">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                  <span data-i18n={keys.periodKey}>{exp.period}</span>
                </span>
              </div>

              <h3 
                data-i18n={keys.companyKey}
                class="font-display font-bold text-xl text-text-primary mb-1"
              >
                {exp.company}
              </h3>

              <div class="inline-flex items-center gap-1 text-xs font-medium text-text-secondary mb-3">
                <svg class="w-3.5 h-3.5 text-[#0047FF] dark:text-[#3B82F6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>
                <span data-i18n={keys.projectKey}>{exp.project}</span>
              </div>

              <p 
                data-i18n={keys.descKey}
                class="text-sm text-text-secondary leading-relaxed"
              >
                {exp.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Experience Timeline Scroll Progress & Card Observer
  document.addEventListener('DOMContentLoaded', () => {
    const timelineContainer = document.getElementById('timeline-container');
    const progressBar = document.getElementById('timeline-progress-bar');
    const progressDot = document.getElementById('timeline-progress-dot');
    const cards = document.querySelectorAll('.experience-card-reveal');

    // 1. IntersectionObserver for Timeline Cards Scroll-Reveal
    const cardObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    cards.forEach((card) => cardObserver.observe(card));

    // 2. Timeline Vertical Scroll Progress Line & Dot Position Calculator
    function updateTimelineProgress() {
      if (!timelineContainer || !progressBar || !progressDot) return;

      const rect = timelineContainer.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      const totalHeight = rect.height;
      const currentScroll = viewportHeight / 2 - rect.top;
      let progress = Math.max(0, Math.min(1, currentScroll / totalHeight));

      const percentage = (progress * 100).toFixed(1);
      const dotPosition = (progress * totalHeight).toFixed(1);

      progressBar.style.height = `${percentage}%`;
      progressDot.style.transform = `translateY(${dotPosition}px)`;
    }

    window.addEventListener('scroll', updateTimelineProgress, { passive: true });
    updateTimelineProgress();
  });
</script>
