---
import experienceData from '../data/experience.json';

const expKeys = [
  { roleKey: 'exp1Role', companyKey: 'exp1Company', projectKey: 'exp1Project', periodKey: 'exp1Period', descKey: 'exp1Desc' },
  { roleKey: 'exp2Role', companyKey: 'exp2Company', projectKey: 'exp2Project', periodKey: 'exp2Period', descKey: 'exp2Desc' },
  { roleKey: 'exp3Role', companyKey: 'exp3Company', projectKey: '', periodKey: 'exp3Period', descKey: 'exp3Desc' },
];
---

<section id="experience" class="py-16 sm:py-24 border-b border-gray-100 bg-gray-50/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mb-12 reveal">
      <div 
        data-i18n="expEyebrow"
        class="inline-block text-xs font-bold uppercase tracking-widest text-[#0047FF] mb-2"
      >
        Experience
      </div>
      <h2 
        data-i18n="expTitle"
        class="font-display text-3xl sm:text-4xl font-bold text-[#000000] mb-4"
      >
        Professional &amp; Field Experience
      </h2>
      <p 
        data-i18n="expDesc"
        class="text-base text-[#4B5563]"
      >
        Professional work experience and field survey operations that built discipline, communication skills, and data precision.
      </p>
    </div>

    <!-- Vertical Timeline -->
    <div class="relative pl-6 sm:pl-8 border-l-2 border-gray-200 max-w-3xl space-y-10 reveal">
      {experienceData.map((exp, idx) => {
        const keys = expKeys[idx] || { roleKey: '', companyKey: '', projectKey: '', periodKey: '', descKey: '' };
        return (
          <div class="relative group">
            <!-- Timeline Node Circle -->
            <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-white border-2 border-[#0047FF] group-hover:bg-[#0047FF] transition-colors"></div>

            <!-- Timeline Content Card -->
            <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-sm hover:border-gray-300 transition-all">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold text-[#0047FF] bg-blue-50 border border-blue-100">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                  <span data-i18n={keys.roleKey}>{exp.role}</span>
                </span>
                <span class="inline-flex items-center gap-1 text-xs font-medium text-[#6B7280]">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                  <span data-i18n={keys.periodKey}>{exp.period}</span>
                </span>
              </div>

              <h3 
                data-i18n={keys.companyKey}
                class="font-display font-bold text-xl text-[#000000] mb-1"
              >
                {exp.company}
              </h3>

              {exp.project && (
                <div class="inline-flex items-center gap-1 text-xs font-medium text-[#4B5563] mb-3">
                  <svg class="w-3.5 h-3.5 text-[#0047FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>
                  <span>Project: <span data-i18n={keys.projectKey}>{exp.project}</span></span>
                </div>
              )}

              <p 
                data-i18n={keys.descKey}
                class="text-sm text-[#4B5563] leading-relaxed"
              >
                {exp.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
