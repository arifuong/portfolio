---
---

<footer class="py-12 bg-gray-50 border-t border-gray-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      
      <!-- Copyright & Name -->
      <div class="text-center sm:text-left">
        <a 
          href="#" 
          class="font-display font-bold text-lg text-[#000000] tracking-tight hover:text-[#0047FF] transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none rounded"
        >
          Mohamad Arifin Hasbi<span class="text-[#0047FF]">.</span>
        </a>
        <p class="text-xs text-[#6B7280] mt-1">
          &copy; {new Date().getFullYear()} <span data-i18n="footerCopyright">Mohamad Arifin Hasbi. All Rights Reserved.</span>
        </p>
      </div>

      <!-- Social Links & Back to Top -->
      <div class="flex items-center gap-4">
        <a 
          href="https://github.com/arifuong" 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-2 text-[#4B5563] hover:text-[#0047FF] hover:bg-white rounded-full border border-gray-200 transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
          aria-label="GitHub Mohamad Arifin Hasbi"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>

        <a 
          href="https://wa.me/6285846653147" 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-2 text-[#4B5563] hover:text-[#0047FF] hover:bg-white rounded-full border border-gray-200 transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
          aria-label="WhatsApp Mohamad Arifin Hasbi"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>

        <a 
          href="mailto:arifuong@gmail.com" 
          class="p-2 text-[#4B5563] hover:text-[#0047FF] hover:bg-white rounded-full border border-gray-200 transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
          aria-label="Email Mohamad Arifin Hasbi"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>

        <div class="w-px h-6 bg-gray-200 mx-1"></div>

        <!-- Back To Top Button -->
        <button 
          id="back-to-top-btn"
          type="button"
          class="p-2.5 text-[#000000] bg-white hover:bg-[#0047FF] hover:text-white rounded-full border border-gray-200 shadow-xs transition-all duration-200 focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
          data-i18n-aria="footerBackToTop"
          aria-label="Back to top of page"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
        </button>
      </div>

    </div>
  </div>
</footer>

<script>
  const backToTopBtn = document.getElementById('back-to-top-btn');

  backToTopBtn?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });
</script>
