---
import skillsData from '../data/skills.json';

const categories = [
  { 
    key: 'languages', 
    title: 'Languages', 
    svg: '<path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>', 
    items: skillsData.languages 
  },
  { 
    key: 'frameworks', 
    title: 'Frameworks & Libraries', 
    svg: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>', 
    items: skillsData.frameworks 
  },
  { 
    key: 'database', 
    title: 'Database', 
    svg: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/>', 
    items: skillsData.database 
  },
  { 
    key: 'tools', 
    title: 'Tools & Ecosystem', 
    svg: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>', 
    items: skillsData.tools 
  },
  { 
    key: 'concepts', 
    title: 'Concepts & Architecture', 
    svg: '<rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>', 
    items: skillsData.concepts 
  },
];
---

<section id="skills" class="py-16 sm:py-24 border-b border-gray-100 bg-gray-50/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mb-12 reveal">
      <div class="inline-block text-xs font-bold uppercase tracking-widest text-[#0047FF] mb-2">
        Keahlian
      </div>
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-[#000000] mb-4">
        Tech Stack &amp; Kompetensi
      </h2>
      <p class="text-base text-[#4B5563]">
        Teknologi dan tools yang biasa saya gunakan dalam membangun aplikasi full stack dari konsep hingga deployment.
      </p>
    </div>

    <!-- Skills Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((cat) => (
        <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-sm hover:border-gray-300 transition-all duration-300 reveal">
          <div class="flex items-center gap-3 mb-4 pb-3 border-b border-gray-100">
            <div class="p-2 rounded-lg bg-blue-50 text-[#0047FF]">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={cat.svg}></svg>
            </div>
            <h3 class="font-display font-semibold text-lg text-[#000000]">
              {cat.title}
            </h3>
          </div>
          
          <div class="flex flex-wrap gap-2">
            {cat.items.map((item) => (
              <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-50 hover:bg-blue-50 text-[#374151] hover:text-[#0047FF] border border-gray-200 hover:border-blue-200 transition-colors">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
