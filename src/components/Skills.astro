---
import skillsData from '../data/skills.json';

const categories = [
  { 
    key: 'catLanguages', 
    titleDefault: 'Bahasa Pemrograman', 
    svg: '<path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>', 
    items: skillsData.languages 
  },
  { 
    key: 'catFrameworks', 
    titleDefault: 'Framework & Library', 
    svg: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>', 
    items: skillsData.frameworks 
  },
  { 
    key: 'catDatabase', 
    titleDefault: 'Database', 
    svg: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/>', 
    items: skillsData.database 
  },
  { 
    key: 'catTools', 
    titleDefault: 'Tools & Ekosistem', 
    svg: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>', 
    items: skillsData.tools 
  },
  { 
    key: 'catConcepts', 
    titleDefault: 'Konsep & Arsitektur', 
    svg: '<rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>', 
    items: skillsData.concepts 
  },
];
---

<section id="skills" class="py-16 sm:py-24 border-b border-gray-100 dark:border-white/8 bg-[#FFFFFF] dark:bg-[#0B1120] transition-colors duration-300 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full">
    <div class="max-w-2xl mb-12">
      <div 
        data-i18n="skillsEyebrow"
        class="inline-block text-xs font-bold uppercase tracking-widest text-[#0047FF] dark:text-[#60A5FA] mb-2"
      >
        Keahlian
      </div>
      <h2 
        data-i18n="skillsTitle"
        class="font-display text-3xl sm:text-4xl font-bold text-text-primary mb-4"
      >
        Tech Stack &amp; Kompetensi
      </h2>
      <p 
        data-i18n="skillsDesc"
        class="text-base text-text-secondary"
      >
        Teknologi dan tools yang rutin saya gunakan untuk merancang, membangun, dan men-deploy aplikasi web full stack.
      </p>
    </div>

    <!-- Skills Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((cat) => (
        <div 
          class="p-6 rounded-2xl glass-card"
        >
          <div class="flex items-center gap-3 mb-4 pb-3 border-b border-gray-100 dark:border-white/8">
            <div class="p-2 rounded-lg bg-blue-50 dark:bg-blue-950/20 text-[#0047FF] dark:text-[#60A5FA]">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={cat.svg}></svg>
            </div>
            <h3 
              data-i18n={cat.key}
              class="font-display font-semibold text-lg text-text-primary"
            >
              {cat.titleDefault}
            </h3>
          </div>
          
          <div class="flex flex-wrap gap-2">
            {cat.items.map((item) => (
              <span 
                class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-50 dark:bg-white/5 hover:bg-blue-50 dark:hover:bg-blue-950/40 text-text-secondary hover:text-[#0047FF] dark:hover:text-[#60A5FA] border border-gray-200 dark:border-white/8 hover:border-blue-200 dark:hover:border-blue-700 transition-all duration-200"
              >
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
