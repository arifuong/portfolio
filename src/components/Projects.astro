---
import projectsData from '../data/projects.json';

const projKeys = [
  { titleKey: 'proj1Title', descKey: 'proj1Desc' },
  { titleKey: 'proj2Title', descKey: 'proj2Desc' },
  { titleKey: 'proj3Title', descKey: 'proj3Desc' },
];
---

<section id="projects" class="py-16 sm:py-24 border-b border-gray-100 dark:border-white/8 bg-[#FFFFFF] dark:bg-[#0B1120] transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full">
    <div class="max-w-2xl mb-12">
      <div 
        data-i18n="projectsEyebrow"
        class="inline-block text-xs font-bold uppercase tracking-widest text-[#0047FF] dark:text-[#60A5FA] mb-2"
      >
        Proyek Unggulan
      </div>
      <h2 
        data-i18n="projectsTitle"
        class="font-display text-3xl sm:text-4xl font-bold text-text-primary mb-4"
      >
        Proyek Pilihan &amp; Karya Akademik
      </h2>
      <p 
        data-i18n="projectsDesc"
        class="text-base text-text-secondary"
      >
        Aplikasi web yang saya bangun dengan penekanan kuat pada keandalan, keamanan data, dan arsitektur yang mudah dirawat.
      </p>
    </div>

    <!-- 3 Project Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projectsData.map((project, idx) => {
        const keys = projKeys[idx] || { titleKey: '', descKey: '' };
        return (
          <article class="flex flex-col rounded-2xl glass-card hover:shadow-xl dark:hover:shadow-2xl dark:hover:shadow-blue-950/30 hover:-translate-y-1 transition-all duration-300 overflow-hidden group">
            <!-- Card Header & Badge -->
            <div class="p-6 pb-4 border-b border-gray-50 dark:border-white/8 flex items-center justify-between">
              <div class="flex items-center gap-2 text-xs font-semibold text-[#0047FF] dark:text-[#60A5FA] uppercase tracking-wider">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/><circle cx="12" cy="13" r="2"/><path d="M14 13h3"/><path d="M7 13h3"/></svg>
                <span>{project.category}</span>
              </div>
              <a 
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-muted hover:text-text-primary dark:hover:text-[#60A5FA] p-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-white/10 transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
                aria-label={`Repositori GitHub ${project.title}`}
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              </a>
            </div>

            <!-- Card Body -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 
                  data-i18n={keys.titleKey}
                  class="font-display font-bold text-xl text-text-primary mb-3 group-hover:text-[#0047FF] dark:group-hover:text-[#60A5FA] transition-colors"
                >
                  {project.title}
                </h3>
                <p 
                  data-i18n={keys.descKey}
                  class="text-sm text-text-secondary leading-relaxed mb-6"
                >
                  {project.description}
                </p>
              </div>

              <!-- Tech Stack Badges -->
              <div class="space-y-4">
                <div class="flex flex-wrap gap-1.5 pt-2">
                  {project.techStack.map((tech) => (
                    <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 dark:bg-white/5 text-text-secondary border border-gray-200 dark:border-white/8">
                      {tech}
                    </span>
                  ))}
                </div>

                <a 
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs font-semibold text-[#0047FF] dark:text-[#93C5FD] hover:text-[#000000] dark:hover:text-[#BFDBFE] pt-2 transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none rounded"
                >
                  <span data-i18n="projectsViewGithub">Lihat Kode Sumber di GitHub</span>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
