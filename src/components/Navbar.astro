---
const navLinks = [
  { href: '#about', labelKey: 'navAbout', defaultLabel: 'About', id: 'about' },
  { href: '#skills', labelKey: 'navSkills', defaultLabel: 'Skills', id: 'skills' },
  { href: '#projects', labelKey: 'navProjects', defaultLabel: 'Projects', id: 'projects' },
  { href: '#experience', labelKey: 'navExperience', defaultLabel: 'Experience', id: 'experience' },
  { href: '#contact', labelKey: 'navContact', defaultLabel: 'Contact', id: 'contact' },
];
---

<!-- Floating Sticky Header Outer Container (z-[9999] isolate permanently on top of all sections) -->
<div 
  id="navbar-container"
  class="fixed top-0 left-0 right-0 z-[9999] isolate flex justify-center w-full px-3 sm:px-6 pointer-events-none transition-all duration-300 ease-[cubic-bezier(0.22,0.61,0.36,1)]"
>
  <header 
    id="navbar-inner"
    class="pointer-events-auto w-full max-w-6xl h-16 flex items-center justify-between px-4 sm:px-6 transition-all duration-300 ease-[cubic-bezier(0.22,0.61,0.36,1)] border border-transparent bg-transparent rounded-full"
  >
    <!-- Left: Brand Logo -->
    <a 
      href="#" 
      class="font-display font-bold text-lg sm:text-xl text-[#000000] tracking-tight hover:text-[#0047FF] transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none rounded-md px-1 py-0.5 shrink-0"
      data-i18n-aria="navAriaHome"
      aria-label="Back to top of Mohamad Arifin Hasbi page"
    >
      Arifin Hasbi<span class="text-[#0047FF]">.</span>
    </a>

    <!-- Center: Navigation Links (Desktop) -->
    <nav class="hidden md:flex items-center justify-center" aria-label="Navigasi Utama">
      <ul class="flex items-center gap-1 text-sm font-medium p-1 bg-gray-100/40 backdrop-blur-xs rounded-full border border-gray-200/40">
        {navLinks.map((link) => (
          <li>
            <a 
              href={link.href} 
              data-i18n={link.labelKey}
              data-nav-section={link.id}
              class="nav-link-item inline-flex items-center px-3.5 py-1.5 rounded-full text-[#4B5563] hover:text-[#000000] hover:bg-white/80 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
            >
              {link.defaultLabel}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right Controls: Language Switcher, GitHub, CV -->
    <div class="hidden md:flex items-center gap-3 shrink-0">
      <!-- Glassmorphism Language Switcher Pill -->
      <div class="flex items-center p-1 rounded-full bg-gray-100/60 backdrop-blur border border-gray-200/60 text-xs font-semibold shadow-xs">
        <button
          type="button"
          data-lang="en"
          class="lang-switcher-btn px-2.5 py-1 rounded-full transition-all duration-200 focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none bg-[#0047FF] text-white shadow-xs"
          aria-label="Switch language to English"
        >
          EN
        </button>
        <span class="text-gray-300 px-0.5 select-none">|</span>
        <button
          type="button"
          data-lang="id"
          class="lang-switcher-btn px-2.5 py-1 rounded-full transition-all duration-200 focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none text-[#4B5563] hover:text-[#000000]"
          aria-label="Ubah bahasa ke Bahasa Indonesia"
        >
          ID
        </button>
      </div>

      <!-- GitHub Icon Link -->
      <a 
        href="https://github.com/arifuong" 
        target="_blank" 
        rel="noopener noreferrer"
        class="p-2 text-[#4B5563] hover:text-[#0047FF] hover:bg-white/70 rounded-full border border-gray-200/60 transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
        data-i18n-aria="heroAriaGithub"
        aria-label="GitHub Profile"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>

      <!-- Download CV Button -->
      <a 
        href="/CV_Mohamad_Arifin_Hasbi.pdf" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-[#000000] hover:bg-[#0047FF] transition-colors rounded-full focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none shadow-xs"
      >
        <span data-i18n="navCvBtn">Download CV</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 text-[#1F2937] hover:text-[#0047FF] focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none rounded-lg"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-i18n-aria="navAriaMenuOpen"
      aria-label="Open navigation menu"
    >
      <svg id="icon-menu" class="w-6 h-6 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      <svg id="icon-close" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </header>
</div>

<!-- Mobile Dropdown Menu (z-[9999] Frosted Glass) -->
<div 
  id="mobile-menu" 
  class="hidden md:hidden fixed top-20 left-3 right-3 z-[9999] border border-[rgba(255,255,255,0.4)] bg-[rgba(255,255,255,0.75)] backdrop-blur-[30px] backdrop-saturate-[180%] px-5 pt-3 pb-6 rounded-3xl shadow-[0_12px_36px_rgba(15,23,42,0.1),inset_0_1px_0_rgba(255,255,255,0.5)] transition-all duration-300"
  aria-label="Navigasi Mobile"
>
  <ul class="flex flex-col gap-3 text-base font-medium">
    {navLinks.map((link) => (
      <li>
        <a 
          href={link.href} 
          data-i18n={link.labelKey}
          class="mobile-nav-link block py-2 px-3 text-[#374151] hover:bg-blue-50/80 hover:text-[#0047FF] rounded-xl transition-colors"
        >
          {link.defaultLabel}
        </a>
      </li>
    ))}

    <!-- Mobile Language Switcher -->
    <li class="pt-3 border-t border-gray-100 flex items-center justify-between px-3">
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Language / Bahasa</span>
      <div class="flex items-center p-1 rounded-full bg-gray-100/80 border border-gray-200/80 text-xs font-semibold">
        <button
          type="button"
          data-lang="en"
          class="lang-switcher-btn px-3 py-1 rounded-full transition-all duration-200 bg-[#0047FF] text-white shadow-xs"
          aria-label="Switch language to English"
        >
          EN
        </button>
        <span class="text-gray-300 px-1 select-none">|</span>
        <button
          type="button"
          data-lang="id"
          class="lang-switcher-btn px-3 py-1 rounded-full transition-all duration-200 text-[#4B5563] hover:text-[#000000]"
          aria-label="Ubah bahasa ke Bahasa Indonesia"
        >
          ID
        </button>
      </div>
    </li>

    <!-- Mobile CV Download Button -->
    <li class="pt-2">
      <a 
        href="/CV_Mohamad_Arifin_Hasbi.pdf" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-2.5 px-4 text-sm font-semibold text-white bg-[#000000] hover:bg-[#0047FF] rounded-xl transition-colors shadow-xs"
      >
        <span data-i18n="navCvBtn">Download CV</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    </li>
  </ul>
</div>

<script>
  // Elements
  const navbarContainer = document.getElementById('navbar-container');
  const navbarInner = document.getElementById('navbar-inner');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
  const navLinkItems = document.querySelectorAll('.nav-link-item');

  // Throttled Scroll State Controller using requestAnimationFrame (60 FPS)
  let isTicking = false;

  function updateNavbarScrollState() {
    const scrollY = window.scrollY;

    if (scrollY >= 40) {
      // True Frosted Glassmorphism Pill (rgba(255,255,255,0.18), blur 30px, saturate 180%, 1px rgba(255,255,255,0.35) border, inset highlight)
      navbarContainer?.classList.add('top-3', 'sm:top-4');
      navbarContainer?.classList.remove('top-0');

      navbarInner?.classList.add(
        'bg-[rgba(255,255,255,0.18)]',
        'backdrop-blur-[30px]',
        'backdrop-saturate-[180%]',
        'border-[rgba(255,255,255,0.35)]',
        'shadow-[0_8px_32px_rgba(15,23,42,0.08),0_2px_8px_rgba(15,23,42,0.04),inset_0_1px_0_rgba(255,255,255,0.45)]',
        'translate-y-0'
      );
      navbarInner?.classList.remove('border-transparent', 'bg-transparent', '-translate-y-1');
    } else {
      // Initial Transparent State
      navbarContainer?.classList.add('top-0');
      navbarContainer?.classList.remove('top-3', 'sm:top-4');

      navbarInner?.classList.add('border-transparent', 'bg-transparent');
      navbarInner?.classList.remove(
        'bg-[rgba(255,255,255,0.18)]',
        'backdrop-blur-[30px]',
        'backdrop-saturate-[180%]',
        'border-[rgba(255,255,255,0.35)]',
        'shadow-[0_8px_32px_rgba(15,23,42,0.08),0_2px_8px_rgba(15,23,42,0.04),inset_0_1px_0_rgba(255,255,255,0.45)]',
        'translate-y-0'
      );
    }

    isTicking = false;
  }

  window.addEventListener('scroll', () => {
    if (!isTicking) {
      window.requestAnimationFrame(updateNavbarScrollState);
      isTicking = true;
    }
  }, { passive: true });

  // Initial Check on Load
  updateNavbarScrollState();

  // Mobile Menu Toggle Handler
  function toggleMenu() {
    const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
    menuBtn?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    iconMenu?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  }

  menuBtn?.addEventListener('click', toggleMenu);

  mobileNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });

  // Active Section Scroll-Spy using IntersectionObserver
  const sections = document.querySelectorAll('section[id]');
  const observerOptions = {
    root: null,
    rootMargin: '-20% 0px -60% 0px',
    threshold: 0
  };

  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        navLinkItems.forEach(item => {
          const sectionRef = item.getAttribute('data-nav-section');
          if (sectionRef === id) {
            item.classList.add('bg-blue-50/90', 'text-[#0047FF]', 'font-semibold');
            item.classList.remove('text-[#4B5563]');
          } else {
            item.classList.remove('bg-blue-50/90', 'text-[#0047FF]', 'font-semibold');
            item.classList.add('text-[#4B5563]');
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach(section => {
    sectionObserver.observe(section);
  });
</script>
