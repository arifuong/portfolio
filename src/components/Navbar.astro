---
const navLinks = [
  { href: '#about', labelKey: 'navAbout', defaultLabel: 'About' },
  { href: '#skills', labelKey: 'navSkills', defaultLabel: 'Skills' },
  { href: '#projects', labelKey: 'navProjects', defaultLabel: 'Projects' },
  { href: '#experience', labelKey: 'navExperience', defaultLabel: 'Experience' },
  { href: '#contact', labelKey: 'navContact', defaultLabel: 'Contact' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/85 border-b border-gray-100 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a 
      href="#" 
      class="font-display font-bold text-lg sm:text-xl text-[#000000] tracking-tight hover:text-[#0047FF] transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none rounded-md px-1 py-0.5"
      data-i18n-aria="navAriaHome"
      aria-label="Back to top of Mohamad Arifin Hasbi page"
    >
      Arifin Hasbi<span class="text-[#0047FF]">.</span>
    </a>

    <!-- Desktop Navigation Links & Controls -->
    <div class="hidden md:flex items-center gap-6">
      <nav aria-label="Navigasi Utama">
        <ul class="flex items-center gap-6 text-sm font-medium">
          {navLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                data-i18n={link.labelKey}
                class="text-[#4B5563] hover:text-[#000000] transition-colors py-1 focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none rounded-md px-2"
              >
                {link.defaultLabel}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Glassmorphism Language Switcher Pill (Desktop) -->
      <div class="flex items-center p-1 rounded-full bg-gray-100/80 backdrop-blur border border-gray-200/80 text-xs font-semibold shadow-xs">
        <button
          type="button"
          data-lang="en"
          class="lang-switcher-btn px-2.5 py-1 rounded-full transition-all duration-200 focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none bg-[#0047FF] text-white shadow-xs"
          aria-label="Switch language to English"
        >
          EN
        </button>
        <span class="text-gray-300 px-0.5 select-none">|</span>
        <button
          type="button"
          data-lang="id"
          class="lang-switcher-btn px-2.5 py-1 rounded-full transition-all duration-200 focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none text-[#4B5563] hover:text-[#000000]"
          aria-label="Ubah bahasa ke Bahasa Indonesia"
        >
          ID
        </button>
      </div>

      <!-- CV Download Button -->
      <a 
        href="/CV_Mohamad_Arifin_Hasbi.pdf" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-[#000000] hover:bg-[#0047FF] transition-colors rounded-full focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
      >
        <span data-i18n="navCvBtn">Download CV</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    </div>

    <!-- Mobile Hamburger Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 text-[#1F2937] hover:text-[#0047FF] focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none rounded-lg"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-i18n-aria="navAriaMenuOpen"
      aria-label="Open navigation menu"
    >
      <svg id="icon-menu" class="w-6 h-6 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      <svg id="icon-close" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden border-b border-gray-100 bg-white/95 backdrop-blur-lg px-4 pt-2 pb-6 transition-all duration-300 shadow-lg"
    aria-label="Navigasi Mobile"
  >
    <ul class="flex flex-col gap-3 text-base font-medium">
      {navLinks.map((link) => (
        <li>
          <a 
            href={link.href} 
            data-i18n={link.labelKey}
            class="mobile-nav-link block py-2 px-3 text-[#374151] hover:bg-gray-50 hover:text-[#0047FF] rounded-lg transition-colors"
          >
            {link.defaultLabel}
          </a>
        </li>
      ))}

      <!-- Mobile Language Switcher -->
      <li class="pt-2 border-t border-gray-100 flex items-center justify-between px-3">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Language / Bahasa</span>
        <div class="flex items-center p-1 rounded-full bg-gray-100/90 border border-gray-200 text-xs font-semibold">
          <button
            type="button"
            data-lang="en"
            class="lang-switcher-btn px-3 py-1 rounded-full transition-all duration-200 bg-[#0047FF] text-white shadow-xs"
            aria-label="Switch language to English"
          >
            EN
          </button>
          <span class="text-gray-300 px-1 select-none">|</span>
          <button
            type="button"
            data-lang="id"
            class="lang-switcher-btn px-3 py-1 rounded-full transition-all duration-200 text-[#4B5563] hover:text-[#000000]"
            aria-label="Ubah bahasa ke Bahasa Indonesia"
          >
            ID
          </button>
        </div>
      </li>

      <!-- Mobile CV Download Button -->
      <li class="pt-2">
        <a 
          href="/CV_Mohamad_Arifin_Hasbi.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full py-2.5 px-4 text-sm font-semibold text-white bg-[#000000] hover:bg-[#0047FF] rounded-xl transition-colors"
        >
          <span data-i18n="navCvBtn">Download CV</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
    menuBtn?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    iconMenu?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  }

  menuBtn?.addEventListener('click', toggleMenu);

  mobileNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });
</script>
