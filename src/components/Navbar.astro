---
const navLinks = [
  { href: '#about', labelKey: 'navAbout', defaultLabel: 'Tentang', id: 'about' },
  { href: '#skills', labelKey: 'navSkills', defaultLabel: 'Keahlian', id: 'skills' },
  { href: '#projects', labelKey: 'navProjects', defaultLabel: 'Proyek', id: 'projects' },
  { href: '#experience', labelKey: 'navExperience', defaultLabel: 'Pengalaman', id: 'experience' },
  { href: '#contact', labelKey: 'navContact', defaultLabel: 'Kontak', id: 'contact' },
];
---

<!-- Floating Fixed Header Outer Container (z-[99999] permanently on top of all sections) -->
<div 
  id="navbar-container"
  class="fixed top-0 left-0 right-0 z-[99999] flex justify-center w-full px-3 pt-3 sm:pt-4 sm:px-6 pointer-events-none transition-all duration-300 ease-out"
>
  <header 
    id="navbar-inner"
    class="pointer-events-auto w-full max-w-6xl h-14 sm:h-16 flex items-center justify-between px-4 sm:px-6 transition-all duration-300 ease-out border border-transparent bg-transparent rounded-full"
  >
    <!-- Left: Brand Logo -->
    <a 
      href="/" 
      class="font-display font-bold text-lg sm:text-xl text-text-primary tracking-tight hover:text-[#0047FF] dark:hover:text-[#60A5FA] transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none rounded-md px-1 py-0.5 shrink-0"
      data-i18n-aria="navAriaHome"
      aria-label="Kembali ke bagian atas halaman Mohamad Arifin Hasbi"
    >
      Arifin Hasbi<span class="text-[#0047FF] dark:text-[#60A5FA]">.</span>
    </a>

    <!-- Center: Navigation Links (Desktop) -->
    <nav class="hidden md:flex items-center justify-center" aria-label="Navigasi Utama">
      <ul class="flex items-center gap-1 text-sm font-medium p-1 bg-gray-100/50 dark:bg-white/5 backdrop-blur-md rounded-full border border-gray-200/50 dark:border-white/10">
        {navLinks.map((link) => (
          <li>
            <a 
              href={link.href} 
              data-i18n={link.labelKey}
              data-nav-section={link.id}
              class="nav-link-item inline-flex items-center px-3.5 py-1.5 rounded-full text-text-secondary hover:text-text-primary dark:hover:text-text-primary hover:bg-white/80 dark:hover:bg-white/10 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
            >
              {link.defaultLabel}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right Controls: Language Switcher, Theme Switcher, GitHub, CV -->
    <div class="hidden md:flex items-center gap-3 shrink-0">
      <!-- Glassmorphism Language Switcher Pill -->
      <div class="lang-switcher-container text-xs font-semibold">
        <button
          type="button"
          data-lang="en"
          class="lang-switcher-btn px-2.5 py-1 rounded-full focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
          aria-label="Ganti bahasa ke Inggris"
        >
          EN
        </button>
        <span class="text-gray-350 dark:text-gray-800 px-0.5 select-none">|</span>
        <button
          type="button"
          data-lang="id"
          class="lang-switcher-btn active px-2.5 py-1 rounded-full focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
          aria-label="Ubah bahasa ke Bahasa Indonesia"
        >
          ID
        </button>
      </div>

      <!-- Glassmorphism Dark Mode Toggle Button (Desktop) -->
      <button
        type="button"
        class="theme-toggle-btn relative w-9 h-9 flex items-center justify-center text-text-secondary hover:text-[#0047FF] dark:hover:text-[#60A5FA] bg-white/40 dark:bg-[rgba(15,23,42,0.65)] hover:bg-white/80 dark:hover:bg-white/15 rounded-full border border-gray-200/60 dark:border-white/10 transition-all duration-300 focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none shadow-xs overflow-hidden"
        aria-label="Ubah Mode Gelap"
      >
        <!-- Sun Icon (Active in Light Mode) -->
        <svg class="theme-icon-sun absolute w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <!-- Moon Icon (Active in Dark Mode) -->
        <svg class="theme-icon-moon absolute w-4 h-4 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>

      <!-- GitHub Icon Link -->
      <a 
        href="https://github.com/arifuong" 
        target="_blank" 
        rel="noopener noreferrer"
        class="p-2 text-text-secondary hover:text-[#0047FF] dark:hover:text-[#60A5FA] hover:bg-white/80 dark:hover:bg-white/10 rounded-full border border-gray-200/60 dark:border-white/8 transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
        data-i18n-aria="heroAriaGithub"
        aria-label="Profil GitHub Mohamad Arifin Hasbi"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>

      <!-- Download CV Button -->
      <a 
        href="/cv/Mohamad-Arifin-Hasbi-CV.pdf" 
        download="Mohamad-Arifin-Hasbi-CV.pdf"
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-[#000000] hover:bg-[#0047FF] dark:bg-[#3B82F6] dark:hover:bg-[#2563EB] transition-colors rounded-full focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none shadow-xs"
      >
        <span data-i18n="navCvBtn">Download CV</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    </div>

    <!-- Mobile Controls Right (Theme Toggle + Mobile Menu Button) -->
    <div class="flex items-center gap-2 md:hidden">
      <!-- Mobile Theme Toggle Button -->
      <button
        type="button"
        class="theme-toggle-btn relative w-9 h-9 flex items-center justify-center text-text-secondary hover:text-[#0047FF] dark:hover:text-[#60A5FA] bg-white/40 dark:bg-[rgba(15,23,42,0.65)] hover:bg-white/80 dark:hover:bg-white/10 rounded-full border border-gray-200/60 dark:border-white/10 transition-all duration-300 focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none shadow-xs overflow-hidden"
        aria-label="Ubah Mode Gelap"
      >
        <!-- Sun Icon (Active in Light Mode) -->
        <svg class="theme-icon-sun absolute w-5 h-5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <!-- Moon Icon (Active in Dark Mode) -->
        <svg class="theme-icon-moon absolute w-5 h-5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="p-2 text-text-primary hover:text-[#0047FF] dark:hover:text-[#60A5FA] focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none rounded-lg"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-i18n-aria="navAriaMenuOpen"
        aria-label="Buka menu navigasi"
      >
        <svg id="icon-menu" class="w-6 h-6 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg id="icon-close" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </header>
</div>

<!-- Mobile Dropdown Menu (z-[99999] Frosted Glass Light & Dark) -->
<div 
  id="mobile-menu" 
  class="hidden md:hidden fixed top-20 left-3 right-3 z-[99999] border border-gray-200/80 dark:border-white/15 bg-white/90 dark:bg-slate-900/95 backdrop-blur-xl px-5 pt-3 pb-6 rounded-3xl shadow-xl transition-all duration-300"
  aria-label="Navigasi Mobile"
>
  <ul class="flex flex-col gap-3 text-base font-medium">
    {navLinks.map((link) => (
      <li>
        <a 
          href={link.href} 
          data-i18n={link.labelKey}
          class="mobile-nav-link block py-2 px-3 text-text-secondary hover:bg-blue-50/80 dark:hover:bg-white/10 hover:text-[#0047FF] dark:hover:text-[#60A5FA] rounded-xl transition-colors"
        >
          {link.defaultLabel}
        </a>
      </li>
    ))}

    <!-- Mobile Language Switcher -->
    <li class="pt-3 border-t border-gray-100 dark:border-white/10 flex items-center justify-between px-3">
      <span class="text-xs font-semibold text-text-muted uppercase tracking-wider">Language / Bahasa</span>
      <div class="lang-switcher-container text-xs font-semibold">
        <button
          type="button"
          data-lang="en"
          class="lang-switcher-btn px-3 py-1 rounded-full focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
          aria-label="Ganti bahasa ke Inggris"
        >
          EN
        </button>
        <span class="text-gray-350 dark:text-gray-800 px-1 select-none">|</span>
        <button
          type="button"
          data-lang="id"
          class="lang-switcher-btn active px-3 py-1 rounded-full focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
          aria-label="Ubah bahasa ke Bahasa Indonesia"
        >
          ID
        </button>
      </div>
    </li>

    <!-- Mobile CV Download Button -->
    <li class="pt-2">
      <a 
        href="/cv/Mohamad-Arifin-Hasbi-CV.pdf" 
        download="Mohamad-Arifin-Hasbi-CV.pdf"
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-2.5 px-4 text-sm font-semibold text-white bg-[#000000] hover:bg-[#0047FF] dark:bg-[#3B82F6] dark:hover:bg-[#2563EB] rounded-xl transition-colors shadow-xs"
      >
        <span data-i18n="navCvBtn">Download CV</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    </li>
  </ul>
</div>

<script>
  // Elements
  const navbarInner = document.getElementById('navbar-inner');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
  const navLinkItems = document.querySelectorAll('.nav-link-item');

  // Throttled Scroll Controller (Smooth Glassmorphism Transition 200ms)
  let isTicking = false;

  function updateNavbarScrollState() {
    const scrollY = window.scrollY || document.documentElement.scrollTop;

    if (scrollY >= 30) {
      // Scrolled: Apply Frosted Glassmorphism background, subtle border & shadow (200-300ms transition)
      navbarInner?.classList.add(
        'bg-white/80',
        'dark:bg-slate-900/80',
        'backdrop-blur-md',
        'border-gray-200/60',
        'dark:border-white/10',
        'shadow-md'
      );
      navbarInner?.classList.remove('bg-transparent', 'border-transparent');
    } else {
      // Top: Transparent state
      navbarInner?.classList.add('bg-transparent', 'border-transparent');
      navbarInner?.classList.remove(
        'bg-white/80',
        'dark:bg-slate-900/80',
        'backdrop-blur-md',
        'border-gray-200/60',
        'dark:border-white/10',
        'shadow-md'
      );
    }

    isTicking = false;
  }

  function onScroll() {
    if (!isTicking) {
      window.requestAnimationFrame(updateNavbarScrollState);
      isTicking = true;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  updateNavbarScrollState();

  // Mobile Menu Toggle Handler
  function toggleMenu() {
    const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
    menuBtn?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    iconMenu?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  }

  menuBtn?.addEventListener('click', toggleMenu);

  mobileNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });

  // Active Section Scroll-Spy using IntersectionObserver
  const sections = document.querySelectorAll('section[id]');
  const observerOptions = {
    root: null,
    rootMargin: '-20% 0px -60% 0px',
    threshold: 0
  };

  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        navLinkItems.forEach(item => {
          const sectionRef = item.getAttribute('data-nav-section');
          if (sectionRef === id) {
            item.classList.add('bg-blue-50/90', 'dark:bg-white/10', 'text-[#0047FF]', 'dark:text-[#60A5FA]', 'font-semibold');
            item.classList.remove('text-text-secondary');
          } else {
            item.classList.remove('bg-blue-50/90', 'dark:bg-white/10', 'text-[#0047FF]', 'dark:text-[#60A5FA]', 'font-semibold');
            item.classList.add('text-text-secondary');
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach(section => {
    sectionObserver.observe(section);
  });
</script>
