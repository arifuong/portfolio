---
---

<section id="hero" class="relative z-10 min-h-screen flex flex-col justify-center py-16 sm:py-24 border-b border-gray-100 bg-[#FFFFFF]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full">
    <div class="max-w-3xl">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gray-50 border border-gray-200 text-xs sm:text-sm font-medium text-[#374151] mb-6">
        <svg class="w-4 h-4 text-[#0047FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        <span data-i18n="heroBadge">GPA 3.64 — STMIK Mardira Indonesia</span>
      </div>

      <!-- Main Headline (Single <h1> on the page) -->
      <h1 
        data-i18n="heroName"
        class="font-display text-4xl sm:text-6xl lg:text-7xl font-bold text-[#000000] tracking-tight leading-[1.05] mb-6"
      >
        Mohamad Arifin Hasbi
      </h1>

      <!-- Subtitle & Brief Role -->
      <p 
        data-i18n="heroRole"
        class="text-xl sm:text-2xl font-medium text-[#0047FF] mb-4"
      >
        Full Stack Developer &amp; Informatics Student
      </p>

      <!-- 1-Sentence Summary (Max 20 words) -->
      <p 
        data-i18n="heroSummary"
        class="text-base sm:text-lg text-[#4B5563] leading-relaxed mb-8 max-w-2xl"
      >
        Building modern web applications with Spring Boot, Laravel, and React using clean architecture and high performance.
      </p>

      <!-- CTAs & Socials -->
      <div class="flex flex-wrap items-center gap-4 mb-6">
        <a 
          href="#projects" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold text-white bg-[#000000] hover:bg-[#0047FF] transition-all duration-200 rounded-full shadow-sm hover:shadow-md focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
        >
          <span data-i18n="heroCtaProjects">View Projects</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7l10 10"/><path d="M17 7v10H7"/></svg>
        </a>

        <a 
          href="/CV_Mohamad_Arifin_Hasbi.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold text-[#1F2937] bg-white border border-gray-300 hover:bg-gray-50 hover:border-gray-400 transition-all duration-200 rounded-full focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
        >
          <svg class="w-4 h-4 text-[#0047FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span data-i18n="heroCtaCv">Download CV</span>
        </a>

        <!-- GitHub Icon Button -->
        <a 
          href="https://github.com/arifuong" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center w-12 h-12 text-[#374151] hover:text-[#0047FF] bg-gray-50 hover:bg-blue-50 border border-gray-200 rounded-full transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none ml-2"
          data-i18n-aria="heroAriaGithub"
          aria-label="GitHub profile of Mohamad Arifin Hasbi"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>

        <!-- LinkedIn Icon Button -->
        <a 
          href="https://www.linkedin.com/in/mohamad-arifin-hasbi-88915b425/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center w-12 h-12 text-[#374151] hover:text-[#0047FF] bg-gray-50 hover:bg-blue-50 border border-gray-200 rounded-full transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
          data-i18n-aria="heroAriaLinkedin"
          aria-label="LinkedIn Profile"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
        </a>
      </div>

      <!-- Subtle LinkedIn Networking Text Link -->
      <p class="text-xs text-[#6B7280]">
        <a 
          href="https://www.linkedin.com/in/mohamad-arifin-hasbi-88915b425/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 hover:text-[#0047FF] underline decoration-gray-300 hover:decoration-[#0047FF] transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none rounded"
        >
          <span data-i18n="heroLinkedinSubtle">Connect with me on LinkedIn for networking and collaboration.</span>
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
        </a>
      </p>
    </div>
  </div>
</section>
