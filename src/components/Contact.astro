---
---

<section id="contact" class="py-16 sm:py-24 border-b border-gray-100 dark:border-white/8 bg-[#FFFFFF] dark:bg-[#0B1120] transition-colors duration-300 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 w-full">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center mb-12">
      <div 
        data-i18n="contactEyebrow"
        class="inline-block text-xs font-bold uppercase tracking-widest text-[#0047FF] dark:text-[#60A5FA] mb-2"
      >
        Kontak
      </div>
      <h2 
        data-i18n="contactTitle"
        class="font-display text-3xl sm:text-4xl font-bold text-text-primary mb-4"
      >
        Mari Terhubung dan Berkolaborasi
      </h2>
      <p 
        data-i18n="contactSubtitle"
        class="text-base text-text-secondary leading-relaxed"
      >
        Saya terbuka untuk peluang magang, proyek freelance, atau diskusi seputar pengembangan web. Silakan hubungi saya melalui media apa pun yang tersedia di bawah ini.
      </p>
    </div>

    <!-- Contact Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- LinkedIn Card -->
      <a 
        href="https://www.linkedin.com/in/mohamad-arifin-hasbi-88915b425/"
        target="_blank"
        rel="noopener noreferrer"
        class="p-5 rounded-2xl glass-card flex items-center justify-between gap-4 transition-all focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none group"
        data-i18n-aria="contactAriaLinkedin"
        aria-label="Profil LinkedIn Mohamad Arifin Hasbi"
      >
        <div class="flex items-center gap-3.5 min-w-0">
          <div class="p-3 rounded-xl bg-white dark:bg-[#0B1120] border border-gray-200 dark:border-white/8 text-[#0047FF] dark:text-[#60A5FA] shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
          </div>
          <div class="min-w-0">
            <div data-i18n="contactLinkedinLabel" class="text-xs font-semibold text-text-primary">LinkedIn</div>
            <div data-i18n="contactLinkedinSubtitle" class="text-xs text-text-muted">Let's connect professionally.</div>
            <div class="text-xs text-text-secondary font-mono truncate mt-0.5">linkedin.com/in/mohamad-arifin-hasbi-88915b425</div>
          </div>
        </div>
        <span data-i18n="contactVisitLinkedin" class="text-xs font-semibold text-[#0047FF] dark:text-[#60A5FA] shrink-0">Lihat Profil &rarr;</span>
      </a>

      <!-- Email Card -->
      <div 
        class="p-5 rounded-2xl glass-card flex items-center justify-between gap-4 group"
      >
        <div class="flex items-center gap-3.5 min-w-0">
          <div class="p-3 rounded-xl bg-white dark:bg-[#0B1120] border border-gray-200 dark:border-white/8 text-[#0047FF] dark:text-[#60A5FA] shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div class="min-w-0">
            <div data-i18n="contactEmailLabel" class="text-xs font-semibold text-text-primary">Email</div>
            <div id="email-text" class="text-sm font-medium text-text-secondary truncate mt-0.5">
              arifuong@gmail.com
            </div>
          </div>
        </div>
        <button 
          id="copy-email-btn"
          type="button"
          class="p-2.5 text-text-secondary hover:text-[#0047FF] dark:hover:text-[#60A5FA] hover:bg-white dark:hover:bg-white/10 rounded-lg border border-transparent hover:border-gray-200 dark:hover:border-white/8 transition-colors focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none shrink-0"
          aria-label="Salin alamat email arifuong@gmail.com"
        >
          <svg id="icon-copy" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <svg id="icon-check" class="w-4 h-4 text-green-600 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
      </div>

      <!-- WhatsApp Card -->
      <a 
        href="https://wa.me/6285846653147"
        target="_blank"
        rel="noopener noreferrer"
        class="p-5 rounded-2xl glass-card flex items-center justify-between gap-4 transition-all focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none group"
      >
        <div class="flex items-center gap-3.5 min-w-0">
          <div class="p-3 rounded-xl bg-white dark:bg-[#0B1120] border border-gray-200 dark:border-white/8 text-green-600 dark:text-green-400 shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="min-w-0">
            <div data-i18n="contactPhoneLabel" class="text-xs font-semibold text-text-primary">WhatsApp</div>
            <div class="text-sm font-medium text-text-secondary group-hover:text-[#0047FF] dark:group-hover:text-[#60A5FA] transition-colors mt-0.5">
              +62 858-4665-3147
            </div>
          </div>
        </div>
        <span data-i18n="contactSendWhatsapp" class="text-xs font-semibold text-[#0047FF] dark:text-[#60A5FA] shrink-0">Kirim Pesan &rarr;</span>
      </a>

      <!-- GitHub Profile Card -->
      <a 
        href="https://github.com/arifuong"
        target="_blank"
        rel="noopener noreferrer"
        class="p-5 rounded-2xl glass-card flex items-center justify-between gap-4 transition-all focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none group"
      >
        <div class="flex items-center gap-3.5 min-w-0">
          <div class="p-3 rounded-xl bg-white dark:bg-[#0B1120] border border-gray-200 dark:border-white/8 text-[#000000] dark:text-[#F8FAFC] shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          </div>
          <div class="min-w-0">
            <div data-i18n="contactGithubLabel" class="text-xs font-semibold text-text-primary">GitHub</div>
            <div class="text-sm font-medium text-text-secondary group-hover:text-[#0047FF] dark:group-hover:text-[#60A5FA] transition-colors mt-0.5">
              github.com/arifuong
            </div>
          </div>
        </div>
        <span data-i18n="contactVisitGithub" class="text-xs font-semibold text-[#0047FF] dark:text-[#60A5FA] shrink-0">Kunjungi Profil &rarr;</span>
      </a>

    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const iconCopy = document.getElementById('icon-copy');
  const iconCheck = document.getElementById('icon-check');
  const emailText = document.getElementById('email-text')?.textContent?.trim() || 'arifuong@gmail.com';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailText);
      iconCopy?.classList.add('hidden');
      iconCheck?.classList.remove('hidden');
      setTimeout(() => {
        iconCopy?.classList.remove('hidden');
        iconCheck?.classList.add('hidden');
      }, 2000);
    } catch (err) {
      console.error('Failed to copy email:', err);
    }
  });
</script>
