---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mohamad Arifin Hasbi — Full Stack Developer & Mahasiswa Teknik Informatika",
  description = "Portofolio resmi Mohamad Arifin Hasbi, Full Stack Developer dan mahasiswa Teknik Informatika STMIK Mardira Indonesia (IPK 3.64). Menguasai Spring Boot, Laravel, React, dan MySQL."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://arifin-hasbi.vercel.app');
const ogImageURL = new URL('/og-image.png', canonicalURL);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Mohamad Arifin Hasbi",
  "jobTitle": "Full Stack Developer",
  "almaMater": {
    "@type": "CollegeOrUniversity",
    "name": "STMIK Mardira Indonesia"
  },
  "url": canonicalURL.toString(),
  "sameAs": [
    "https://github.com/arifuong",
    "https://www.linkedin.com/in/mohamad-arifin-hasbi-88915b425/",
    "https://wa.me/6285846653147"
  ],
  "knowsAbout": [
    "Software Engineering",
    "Full Stack Development",
    "Java", "Spring Boot",
    "PHP", "Laravel", "CodeIgniter",
    "JavaScript", "TypeScript", "React",
    "MySQL"
  ]
};
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/profile.webp" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#ffffff" id="theme-meta" />

  <!-- Anti-Flicker Inline Theme Script (Executes before initial DOM render) -->
  <script is:inline>
    (function() {
      try {
        var savedTheme = localStorage.getItem('theme');
        var isDark;
        if (savedTheme) {
          isDark = savedTheme === 'dark';
        } else {
          isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        var meta = document.getElementById('theme-meta');
        if (meta) {
          meta.setAttribute('content', isDark ? '#0B1120' : '#ffffff');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Google Fonts Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={ogImageURL} />

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <!-- i18n & Theme Scripts -->
  <script is:inline src="/js/theme.js"></script>
  <script is:inline src="/js/i18n.js"></script>
  <script is:inline src="/js/main.js"></script>
  <script is:inline src="/js/protection.js"></script>
</head>
<body class="bg-[#FFFFFF] dark:bg-[#0B1120] text-[#4B5563] dark:text-[#CBD5E1] antialiased selection:bg-[#0047FF] dark:selection:bg-[#60A5FA] selection:text-white min-h-screen flex flex-col w-full max-w-full overflow-x-hidden transition-colors duration-300">
  <slot />
</body>
</html>
