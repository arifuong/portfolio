---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="404 — Halaman Tidak Ditemukan | Portfolio Mohamad Arifin Hasbi"
  description="Halaman yang Anda cari tidak ditemukan. Kembali ke beranda portfolio Mohamad Arifin Hasbi — Full Stack Developer & AI Engineer."
>
  <Navbar />

  <main id="main-content" class="flex-1 flex flex-col items-center justify-center min-h-[70vh] px-4 py-24 text-center">
    <div class="max-w-md mx-auto">
      <div class="inline-flex items-center justify-center w-16 h-16 mb-6 rounded-2xl bg-blue-50 dark:bg-blue-950/30 text-[#0047FF] dark:text-[#60A5FA] font-mono text-2xl font-bold border border-blue-100 dark:border-blue-900/30">
        404
      </div>

      <h1 class="font-display text-3xl sm:text-4xl font-bold text-text-primary mb-4 tracking-tight">
        Halaman Tidak Ditemukan
      </h1>

      <p class="text-base text-text-secondary leading-relaxed mb-8">
        Maaf, halaman yang Anda tuju tidak ada atau telah dipindahkan. Silakan kembali ke beranda portfolio Mohamad Arifin Hasbi.
      </p>

      <a 
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3.5 text-sm font-semibold text-white bg-[#000000] dark:bg-[#3B82F6] hover:bg-[#0047FF] dark:hover:bg-[#2563EB] transition-colors rounded-full shadow-sm focus-visible:ring-2 focus-visible:ring-[#0047FF] focus-visible:outline-none"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        <span>Kembali ke Beranda</span>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
