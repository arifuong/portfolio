import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Mohamad Arifin Hasbi — Full Stack Developer & Mahasiswa IT"
  description="Portfolio resmi Mohamad Arifin Hasbi, mahasiswa Teknik Informatika STMIK Mardira Indonesia (IPK 3.64). Menguasai Laravel, Spring Boot, React, CodeIgniter, dan MySQL."
>
  <Navbar />
  
  <main id="main-content">
    <Hero />
    <About />
    <Skills />
    <Projects />
    <Experience />
    <Contact />
  </main>

  <Footer />
