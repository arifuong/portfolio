---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Mohamad Arifin Hasbi | Full Stack Developer Portfolio"
  description="Portfolio Mohamad Arifin Hasbi, Full Stack Developer & AI Engineer Indonesia. Pengalaman Spring Boot, Laravel, React, Google Cloud, dan Machine Learning."
  keywords="Mohamad Arifin Hasbi, Portfolio Mohamad Arifin Hasbi, Full Stack Developer, AI Engineer, Cloud Computing, Machine Learning, Google Cloud, Data Analyst, web developer, Laravel, Spring Boot, React, CodeIgniter, MySQL, STMIK Mardira Indonesia, Teknik Informatika, Cloud Engineer"
>
  <Navbar />
  
  <main id="main-content">
    <Hero />
    <About />
    <Skills />
    <Projects />
    <Experience />
    <Contact />
  </main>

  <Footer />
</Layout>
